{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "ui_kits/control_catalog/**",
              "ui_kits/pulse/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Cascadia Code))/i]",
        "message": "Font not provided by the design system. Available: Inter, Cascadia Code."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|accent|outline|transparent)$/]",
        "message": "<Button> variant must be one of 'standard' | 'accent' | 'outline' | 'transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|radius|surface|bordered|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, radius, surface, bordered."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|indeterminate|onChange|disabled|children|pulse|key|ref|className|style|children)$/]",
        "message": "<CheckBox> doesn't accept that prop. Declared props: checked, indeterminate, onChange, disabled, children, pulse."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboBoxItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ComboBoxItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Expander'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|expanded|onToggle|direction|key|ref|className|style|children)$/]",
        "message": "<Expander> doesn't accept that prop. Declared props: header, expanded, onToggle, direction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Expander'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:down|up)$/]",
        "message": "<Expander> direction must be one of 'down' | 'up'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HyperlinkButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:visited|disabled|key|ref|className|style|children)$/]",
        "message": "<HyperlinkButton> doesn't accept that prop. Declared props: visited, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|key|ref|className|style|children)$/]",
        "message": "<ListItem> doesn't accept that prop. Declared props: selected, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|onClose|key|ref|className|style|children)$/]",
        "message": "<NotificationCard> doesn't accept that prop. Declared props: type, title, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:information|success|warning|error)$/]",
        "message": "<NotificationCard> type must be one of 'information' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PathIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|size|color|key|ref|className|style|children)$/]",
        "message": "<PathIcon> doesn't accept that prop. Declared props: data, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|indeterminate|showText|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, indeterminate, showText."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|name|disabled|children|pulse|key|ref|className|style|children)$/]",
        "message": "<RadioButton> doesn't accept that prop. Declared props: checked, onChange, name, disabled, children, pulse."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|disabled|key|ref|className|style|children)$/]",
        "message": "<SearchBox> doesn't accept that prop. Declared props: placeholder, value, onChange, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: items, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|disabled|showValue|pulse|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, onChange, disabled, showValue, pulse."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|orientation|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: selected, icon, orientation."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<TabItem> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|disabled|error|innerLeft|innerRight|pulse|key|ref|className|style|children)$/]",
        "message": "<TextBox> doesn't accept that prop. Declared props: label, placeholder, value, onChange, disabled, error, innerLeft, innerRight, pulse."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|key|ref|className|style|children)$/]",
        "message": "<ToggleButton> doesn't accept that prop. Declared props: checked, onChange, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|onContent|offContent|showContent|pulse|key|ref|className|style|children)$/]",
        "message": "<ToggleSwitch> doesn't accept that prop. Declared props: checked, onChange, disabled, onContent, offContent, showContent, pulse."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|status|count|defaultExpanded|items|children|key|ref|className|style|children)$/]",
        "message": "<TreeNode> doesn't accept that prop. Declared props: name, icon, status, count, defaultExpanded, items, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TreeNode'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:on|off)$/]",
        "message": "<TreeNode> status must be one of 'on' | 'off'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
